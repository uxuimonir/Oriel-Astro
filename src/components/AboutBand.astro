---
import Words from "./Words.astro"
import Frame from "./Frame.astro"
import { about } from "@/data/content"
const [lead, ...rest] = about.paragraphs
interface Props { pad?: "home" | "journal" | "studio" }
const { pad = "home" } = Astro.props
/** Framer pads this band differently on each page (phone / tablet / desktop). */
const pads = { home: "px-5 py-12 md:px-6 md:py-16 lg:px-12 lg:py-[100px]", journal: "px-5 py-12 md:px-6 md:py-16 lg:px-12 lg:py-32", studio: "px-5 py-20 md:px-8 md:py-24 lg:px-12 lg:py-32" }

---
<section class={`bg-stone ${pads[pad]}`} data-reveal>
  <div class="mx-auto flex max-w-[1536px] flex-col gap-8 lg:gap-12">
    <div class="flex flex-col gap-4 lg:gap-6" data-reveal="rise">
      <p class="t-meta accent">{about.eyebrow}</p>
      <h2 class="flex flex-col gap-1">
        <span class="t-l"><Words text={about.title[0]} /></span>
        <span class="flex flex-wrap items-end gap-2 md:gap-3 lg:gap-4">
          <span class="t-l"><Words text={about.title[1]} /></span>
          <span class="t-l-serif"><Words text={about.title[2]} /></span>
        </span>
      </h2>
    </div>

    <div class="flex flex-col gap-6 md:gap-8 lg:flex-row lg:gap-16">
      <div class="flex flex-col justify-center gap-4 lg:flex-1">
        <p class="t-lead">{lead}</p>
        {rest.map((p) => <p class="t-body">{p}</p>)}
        <dl class="pt-4">
          {about.facts.map(([k, v], i) => (
            <div class={`flex gap-4 border-t border-hairline py-2 ${i === about.facts.length - 1 ? "border-b" : ""}`}>
              <dt class="t-meta w-24 shrink-0 md:w-[120px]">{k}</dt>
              <dd class="t-small flex-1">{v}</dd>
            </div>
          ))}
        </dl>
      </div>
      <figure class={`flex flex-col gap-3 md:w-[42%] lg:w-[38%] lg:pl-12 lg:pt-20 ${pad === "studio" ? "pl-5 pt-12 md:pl-8 md:pt-16" : "md:pl-6 md:pt-10"}`}>
        <a href="/studio" aria-label="About Mira">
          <Frame src={about.image} alt={about.alt} class="aspect-[0.8] w-full" style="--frame-from:1.03;--frame-dur:1.1s" sizes="(min-width:1200px) 420px, 100vw" />
        </a>
        <figcaption class="t-meta">{about.caption}</figcaption>
      </figure>
    </div>

    <div class="flex flex-col gap-3">
      <p class="t-meta">{about.clientsLabel}</p>
      <p class="t-lead">{about.clients.split(" · ").map((c) => c.replace(/ /g, "\u00a0")).join(" · ")}</p>
    </div>
  </div>
</section>
