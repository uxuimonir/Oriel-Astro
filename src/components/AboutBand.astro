---
import Words from "./Words.astro"
import Frame from "./Frame.astro"
import Reveal from "./Reveal.astro"
import { about } from "@/data/content"
---
<section class="band bg-stone/50">
  <div class="shell">
    <p class="t-meta text-ash">{about.eyebrow}</p>
    <h2 class="t-l mt-5 max-w-[20ch]">
      <Words text={about.title[0]} />{" "}
      <span class="t-l-serif italic"><Words text={about.title[1]} /></span>
    </h2>

    <div class="mt-12 grid gap-12 lg:grid-cols-[1.3fr_0.9fr]">
      <div class="space-y-5">
        {about.paragraphs.map((p, i) => (
          <p class="t-body max-w-[62ch] text-ash" data-reveal style={`--reveal-delay:${(i * 0.07).toFixed(2)}s`}>{p}</p>
        ))}
      </div>
      <figure>
        <Frame src={about.image} alt={about.alt} class="aspect-[3/4] w-full" sizes="(min-width:1200px) 32vw, 100vw" />
        <figcaption class="t-meta mt-3 text-ash">{about.caption}</figcaption>
      </figure>
    </div>

    <ul class="mt-14 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
      {about.facts.map(([k, v], i) => (
        <li class="rule pt-4" data-reveal style={`--reveal-delay:${(i * 0.07).toFixed(2)}s`}>
          <p class="t-meta text-ash">{k}</p>
          <p class="t-small mt-2">{v}</p>
        </li>
      ))}
    </ul>

    <div class="rule mt-12 pt-6">
      <p class="t-meta text-ash">{about.clientsLabel}</p>
      <p class="t-small mt-3 max-w-[90ch]">{about.clients}</p>
    </div>
  </div>
</section>
