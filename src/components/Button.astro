---
/**
 * Framer "Button" component. Variants: primary (Basalt pill), secondary (Salt pill), outline, ghost,
 * text (blue underline), ghostDark, textDark, light (light pill on dark bands).
 * Hover: label slides 4px right, 0.3s [0.22,1,0.36,1]; primary fill → Dusk.
 */
interface Props { href: string; variant?: "primary" | "secondary" | "outline" | "ghost" | "text" | "ghostDark" | "textDark" | "light"; class?: string; external?: boolean }
const { href, variant = "text", class: className = "", external = false } = Astro.props
const pill = "rounded-full px-7 py-[18px]"
const styles: Record<string, string> = {
  primary: `${pill} bg-basalt text-salt hover:bg-dusk`,
  secondary: `${pill} bg-paper text-basalt-fixed hover:bg-paperdim`,
  outline: `${pill} border border-hairline hover:border-basalt`,
  ghost: "pt-2",
  text: "border-b border-blue py-1.5",
  ghostDark: `${pill} border border-hairlinedark text-ondark`,
  textDark: "border-b border-bluenight py-1.5 text-ondark",
  light: `${pill} bg-paper text-basalt-fixed hover:bg-paperdim`,
}
---
<a
  href={href}
  class={`btn t-button inline-flex items-center justify-center gap-2.5 transition-colors duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] ${styles[variant]} ${className}`}
  {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
><span class="btn-label"><slot /></span></a>
