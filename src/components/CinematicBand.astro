---
import Words from "./Words.astro"
import Frame from "./Frame.astro"
import { cinematic } from "@/data/content"
---
<section class="on-dark bg-dusk px-5 py-8 md:px-6 md:py-16 lg:px-12 lg:py-[100px]" data-reveal>
  <div class="relative mx-auto flex aspect-[0.8] max-w-[1536px] flex-col justify-end gap-4 overflow-hidden px-5 py-4 md:aspect-[1.3] md:p-6 lg:aspect-[1.78] lg:gap-6 lg:p-12">
    <Frame src={cinematic.image} alt={cinematic.alt} hover={false} class="!absolute inset-0 h-full w-full" sizes="100vw" />
    <div aria-hidden="true" class="absolute inset-0" style="background:linear-gradient(0deg, rgba(10,11,12,0.78) 0%, rgba(10,11,12,0.42) 42%, rgba(10,11,12,0) 76%)"></div>
    <h2 class="relative z-[1] flex flex-col gap-1">
      <span class="t-l"><Words text={cinematic.title[0]} /></span>
      <span class="flex flex-wrap items-end gap-2 md:gap-3 lg:gap-4">
        <span class="t-l"><Words text={cinematic.title[1]} /></span>
        <span class="t-l-serif"><Words text={cinematic.title[2]} /></span>
      </span>
    </h2>
    <p class="t-meta relative z-[1] w-[84%] md:w-auto">{cinematic.caption}</p>
  </div>
</section>
