---
import Words from "./Words.astro"
import Frame from "./Frame.astro"
import { commissions } from "@/data/content"
---
<section class="band">
  <div class="shell">
    <p class="t-meta text-ash">{commissions.eyebrow}</p>
    <h2 class="t-l mt-5 max-w-[16ch]">
      <Words text={commissions.title[0]} />{" "}
      <span class="t-l-serif italic"><Words text={commissions.title[1]} /></span>
    </h2>

    <ul class="mt-12">
      {commissions.services.map((s, i) => (
        <li
          class="rule group grid items-center gap-6 py-7 md:grid-cols-[64px_1.1fr_1.6fr_auto]"
          data-reveal
          style={`--reveal-delay:${(i * 0.08).toFixed(2)}s`}
        >
          <span class="t-meta text-ash">{s.index}</span>
          <h3 class="t-m">{s.title}</h3>
          <p class="t-small max-w-[52ch] text-ash">{s.copy}</p>
          <div class="flex items-center gap-5">
            <span class="t-meta hidden text-ash lg:block">{s.clients}</span>
            <Frame
              src={s.image}
              alt={`${s.title} commission`}
              hover={false}
              sizes="120px"
              class="h-0 w-0 opacity-0 transition-all duration-500 group-hover:h-[84px] group-hover:w-[120px] group-hover:opacity-100"
            />
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
