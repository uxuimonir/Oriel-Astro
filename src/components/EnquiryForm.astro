---
import { enquiry } from "@/data/content"
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? ""
const line = "t-body w-full border-0 border-b border-hairlinedark bg-transparent px-0 py-3 text-ondark placeholder:text-ashnight/70 focus:border-bluenight focus:outline-none"
---
<form id="enquiry-form" class="grid gap-8" data-endpoint={endpoint} data-to={enquiry.to} aria-describedby="enquiry-status">
  <div class="grid gap-8 sm:grid-cols-2">
    <label class="grid gap-1"><span class="t-meta text-ashnight">Name</span>
      <input class={line} name="name" type="text" autocomplete="name" required placeholder="Your name" /></label>
    <label class="grid gap-1"><span class="t-meta text-ashnight">Email</span>
      <input class={line} name="email" type="email" autocomplete="email" required placeholder="you@studio.com" /></label>
  </div>
  <div class="grid gap-8 sm:grid-cols-2">
    <label class="grid gap-1"><span class="t-meta text-ashnight">Kind of commission</span>
      <select class={line} name="kind">{enquiry.kinds.map((k) => <option class="bg-night">{k}</option>)}</select></label>
    <label class="grid gap-1"><span class="t-meta text-ashnight">Place and season</span>
      <input class={line} name="place" type="text" placeholder="Alentejo, early autumn" /></label>
  </div>
  <label class="grid gap-1"><span class="t-meta text-ashnight">Message</span>
    <textarea class={`${line} min-h-[160px] resize-y`} name="message" required placeholder="Tell me about the place and what the light should do."></textarea></label>
  <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
  <div class="flex flex-wrap items-center gap-6">
    <button type="submit" id="enquiry-submit" class="t-button inline-flex items-center gap-2 rounded-full bg-ondark px-6 py-3 text-night transition-colors duration-300 hover:bg-bluenight disabled:opacity-70">Send enquiry →</button>
    <p id="enquiry-status" role="status" class="t-small text-ashnight"></p>
  </div>
</form>

<script>
  function init() {
    const form = document.getElementById("enquiry-form") as HTMLFormElement | null
    if (!form || form.dataset.bound) return
    form.dataset.bound = "1"
    const status = document.getElementById("enquiry-status")!
    const btn = document.getElementById("enquiry-submit") as HTMLButtonElement
    form.addEventListener("submit", async (e) => {
      e.preventDefault()
      const data = new FormData(form)
      if (data.get("company")) return
      const endpoint = form.dataset.endpoint
      if (!endpoint) {
        const body = [...data.entries()].filter(([k]) => k !== "company").map(([k, v]) => `${k}: ${v}`).join("\n")
        window.location.href = `mailto:${form.dataset.to}?subject=${encodeURIComponent("New Oriel enquiry")}&body=${encodeURIComponent(body)}`
        status.textContent = "Thank you — I'll reply within two working days."
        return
      }
      btn.disabled = true
      btn.textContent = "Sending…"
      try {
        const res = await fetch(endpoint, { method: "POST", body: data, headers: { Accept: "application/json" } })
        if (!res.ok) throw new Error(String(res.status))
        form.reset()
        status.textContent = "Thank you — I'll reply within two working days."
      } catch {
        status.textContent = `Something went wrong. Please email ${form.dataset.to} instead.`
      } finally {
        btn.disabled = false
        btn.textContent = "Send enquiry →"
      }
    })
  }
  init()
  document.addEventListener("astro:page-load", init)
</script>
