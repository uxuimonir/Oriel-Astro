---
import SectionHead from "./SectionHead.astro"
import { faq } from "@/data/content"
---
<section class="band bg-night text-ondark">
  <div class="shell grid gap-12 lg:grid-cols-[1fr_1.4fr]">
    <div>
      <p class="t-meta text-ashnight">{faq.eyebrow}</p>
      <h2 class="t-l mt-5 max-w-[10ch]">{faq.title[0]} <span class="t-l-serif italic">{faq.title[1]}</span></h2>
      <p class="t-small mt-6 max-w-[40ch] text-ashnight">{faq.body}</p>
    </div>

    <ul>
      {faq.items.map((item, i) => (
        <li class="rule-dark">
          <details class="group" name="faq">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-7 text-left">
              <span class="t-body max-w-[44ch]">{item.q}</span>
              <span aria-hidden="true" class="text-[28px] font-light leading-none text-ashnight transition-transform duration-300 group-open:rotate-45">+</span>
            </summary>
            <p class="t-small max-w-[64ch] pb-7 text-ashnight">{item.a}</p>
          </details>
        </li>
      ))}
    </ul>
  </div>
</section>
