---
/** Framer "FAQ" + "FAQ Item": one open at a time, "+" / "–" sign, question dims to 72% on hover. */
import Words from "./Words.astro"
import { faq } from "@/data/content"
interface Props { pad?: "home" | "journal" | "studio" }
const { pad = "home" } = Astro.props
/** Framer pads this band differently on each page (phone / tablet / desktop). */
const pads = { home: "px-5 pb-12 pt-10 md:px-6 md:py-20 lg:px-12 lg:py-[100px]", journal: "px-5 pb-12 pt-10 md:px-6 md:py-20 lg:px-12 lg:py-32", studio: "px-5 py-20 md:px-8 md:py-24 lg:px-12 lg:py-32" }
---
<section class={`on-dark bg-dusk lg:border-t lg:border-hairlinedark ${pads[pad]}`} data-reveal>
  <div class="mx-auto flex max-w-[1536px] flex-col gap-10 md:flex-row md:gap-12 lg:gap-16">
    <div class="flex flex-col gap-4 md:flex-1 lg:gap-6" data-reveal="rise">
      <p class="t-meta accent">{faq.eyebrow}</p>
      <h2 class="flex flex-wrap items-end gap-2 md:gap-3 lg:gap-4">
        <span class="t-l"><Words text={faq.title[0]} /></span>
        <span class="t-l-serif"><Words text={faq.title[1]} /></span>
      </h2>
      <p class="t-small max-w-[360px]">{faq.body}</p>
    </div>
    <ul class="flex flex-col gap-1.5 md:flex-[1.4]">
      {faq.items.map((item) => (
        <li class="border-b border-hairlinedark">
          <details class="faq group" name="faq">
            <summary class="flex cursor-pointer list-none items-center justify-between py-5">
              <span class="faq-q t-body flex-1 pr-6">{item.q}</span>
              <span aria-hidden="true" class="t-body w-4 text-center text-ashnight"><span class="group-open:hidden">+</span><span class="hidden group-open:inline">–</span></span>
            </summary>
            <p class="t-small max-w-[640px] pb-5">{item.a}</p>
          </details>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .faq-q { transition: color 0.4s var(--ease-spring-snap); }
  .faq summary:hover .faq-q { color: rgba(255, 255, 255, 0.72); }
  .faq summary::-webkit-details-marker { display: none; }
  .faq::details-content { block-size: 0; overflow: clip; transition: block-size 0.4s var(--ease-spring-snap), content-visibility 0.4s allow-discrete; }
  .faq[open]::details-content { block-size: auto; }
  :global(html) { interpolate-size: allow-keywords; }
</style>
