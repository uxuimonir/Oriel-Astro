---
import Logo from "./Logo.astro"
import { footer, site } from "@/data/content"
const [series, studio] = footer.columns
---
<footer class="on-dark border-t border-hairlinedark bg-night px-5 pb-6 pt-12 md:px-8 md:pb-7 md:pt-[68px] lg:px-12 lg:pb-10 lg:pt-24">
  <div class="mx-auto flex max-w-[1440px] flex-col gap-11 md:gap-[60px] lg:gap-20">
    <div class="flex flex-col gap-8 md:flex-row md:flex-wrap md:gap-10 lg:grid lg:grid-cols-[437fr_180fr_162fr_325fr] lg:gap-0">
      <div class="flex flex-col gap-6">
        <Logo dark />
        <p class="t-small max-w-[340px] md:w-[205px] lg:w-auto">{footer.blurb}</p>
      </div>

      <div class="flex gap-8 md:flex-1 lg:contents">
        {[series, studio].map((col) => (
          <nav aria-label={col.title} class="flex w-[140px] flex-col gap-3 md:w-auto md:px-2 lg:px-0">
            <p class="t-meta">{col.title}</p>
            {col.links.map((l) =>
              l.href ? (
                <a href={l.href} class="t-small link-quiet self-start text-ondark">{l.label}</a>
              ) : (
                <span class="t-small">{l.label}</span>
              )
            )}
          </nav>
        ))}
      </div>

      <div class="flex flex-col gap-3 md:flex-1">
        <p class="t-meta">{footer.letterTitle}</p>
        <p class="t-small">{footer.letter}</p>
        <a href={site.instagram} rel="noopener noreferrer" target="_blank" class="t-button self-start border-b border-bluenight py-1 text-ondark transition-colors hover:text-bluenight">Instagram ↗</a>
      </div>
    </div>

    <div class="flex flex-col gap-6 border-t border-hairlinedark pt-6 md:flex-row md:flex-wrap md:items-center md:justify-between">
      <p class="t-meta max-w-[760px] md:w-[70%] lg:flex-1">{footer.legal}</p>
      <a href="#top" class="t-button self-start text-ondark transition-colors hover:text-bluenight md:self-auto">{footer.back}</a>
    </div>
  </div>
</footer>
