---
import Words from "./Words.astro"
import Frame from "./Frame.astro"
import { hero } from "@/data/content"
---
<section class="pt-10 md:pt-16">
  <div class="shell">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <h1 class="t-hero max-w-[9ch]"><Words text={hero.title} /></h1>
      <p class="t-body max-w-[360px] text-ash">{hero.intro}</p>
    </div>

    <Frame src={hero.image} alt={hero.alt} eager class="mt-8 aspect-[16/9] w-full md:mt-10" sizes="100vw" />

    <div class="mt-5 flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
      <ul class="grid grid-cols-2 gap-x-8 gap-y-2 lg:grid-cols-4">
        {hero.caption.map((c) => <li class="t-meta text-ash">{c}</li>)}
      </ul>
      <p class="t-hero-serif shrink-0 italic"><Words text={hero.serif} /></p>
    </div>
  </div>
</section>
