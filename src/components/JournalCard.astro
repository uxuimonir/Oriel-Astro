---
/** Framer "Journal Card": 360px cover, "Category · Date · Read" meta row, Lead title. */
import Frame from "./Frame.astro"
import type { Post } from "@/data/content"
interface Props { post: Post; delay?: number }
const { post, delay = 0 } = Astro.props
---
<li data-reveal="rise" style={`--reveal-delay:${delay}s`}>
  <a href={`/journal/${post.slug}`} class="group flex flex-col gap-3">
    <Frame src={post.cover} alt={post.coverAlt} class="h-[220px] w-full md:h-[300px] lg:h-[360px]" style="--frame-from:1.04;--frame-dur:1.1s" sizes="(min-width:810px) 50vw, 100vw" />
    <p class="t-meta flex gap-[5px]">{post.category}<span>·</span>{post.dateLabel}<span>·</span>{post.read}</p>
    <h3 class="t-lead card-title truncate">{post.title}</h3>
  </a>
</li>
