---
/** Framer "Journal Feature": 58% image (3:2, 426px), text column aligned to the bottom. */
import Frame from "./Frame.astro"
import Words from "./Words.astro"
import type { Post } from "@/data/content"
import { journal } from "@/data/content"
interface Props { post: Post }
const { post } = Astro.props
---
<article class="flex flex-col gap-12 md:flex-row md:items-end">
  <a href={`/journal/${post.slug}`} class="block md:w-[58%]" aria-label={post.title}>
    <Frame src={post.cover} alt={post.coverAlt} eager class="aspect-[1.5] w-full" style="--frame-from:1.03;--frame-dur:1.1s" sizes="(min-width:810px) 58vw, 100vw" />
  </a>
  <div class="flex flex-col items-start gap-4 md:flex-1">
    <p class="t-meta accent">{post.featureMeta}</p>
    <h2 class="t-m"><a href={`/journal/${post.slug}`}><Words text={post.title} /></a></h2>
    <p class="t-lead">{post.standfirst}</p>
    <a href={`/journal/${post.slug}`} class="btn t-button border-b border-blue py-1"><span class="btn-label">{journal.read}</span></a>
  </div>
</article>
