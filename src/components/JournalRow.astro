---
import Frame from "./Frame.astro"
import type { Post } from "@/data/content"
interface Props { post: Post; delay?: number; full?: boolean }
const { post, delay = 0, full = false } = Astro.props
---
<li class="rule" data-reveal style={`--reveal-delay:${delay}s`}>
  <a href={`/journal/${post.slug}`} class="group grid items-center gap-5 py-6 md:grid-cols-[1.8fr_auto_auto_96px]">
    <div>
      <h3 class="t-m text-[22px] transition-colors group-hover:text-blue md:text-[26px]">{post.title}</h3>
      {full && <p class="t-small mt-2 max-w-[60ch] text-ash">{post.standfirst}</p>}
    </div>
    <span class="t-meta text-ash">{post.category}</span>
    <span class="t-meta text-ash">{post.dateLabel} · {post.read}</span>
    <Frame src={post.cover} alt={post.coverAlt} hover={false} sizes="96px" class="hidden aspect-[4/3] w-24 opacity-0 transition-opacity duration-500 group-hover:opacity-100 md:block" />
  </a>
</li>
