---
import Logo from "./Logo.astro"
import { site } from "@/data/content"
const path = Astro.url.pathname
---
<header id="nav" class="fixed inset-x-0 top-0 z-50 bg-salt transition-opacity duration-[350ms] ease-[cubic-bezier(0.22,1,0.36,1)]">
  <nav class="flex items-center justify-between gap-6 px-5 py-4 md:px-8 md:py-5 lg:px-12" aria-label="Primary">
    <Logo />

    <p class="hidden items-center gap-2 lg:flex">
      <span aria-hidden="true" class="h-[7px] w-[7px] rounded-full bg-blue"></span>
      <span class="t-meta">{site.lightReport}</span>
    </p>

    <ul class="hidden items-center gap-7 md:flex">
      {site.nav.map((l) => {
        const here = path.startsWith(l.href)
        return (
          <li>
            <a href={l.href} class="t-button link-nav" aria-current={here ? "page" : undefined}>{l.label}</a>
          </li>
        )
      })}
    </ul>

    <button id="nav-toggle" type="button" class="t-button py-2 md:hidden" aria-expanded="false" aria-controls="nav-drawer">Menu</button>
  </nav>

  <div id="nav-drawer" class="grid grid-rows-[0fr] overflow-hidden bg-salt transition-[grid-template-rows] duration-[400ms] ease-[cubic-bezier(0.22,1,0.36,1)] md:hidden">
    <div class="min-h-0">
      <div class="border-y border-hairline px-5 pb-7 pt-2">
        <ul class="flex flex-col">
          {site.nav.map((l, i) => (
            <li class="border-b border-hairline">
              <a href={l.href} class="t-m link-nav flex items-center justify-between py-4">
                {l.label}
                <span class="t-meta">{String(i + 1).padStart(2, "0")}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="flex items-center gap-2 pt-6">
          <span aria-hidden="true" class="h-[7px] w-[7px] rounded-full bg-blue"></span>
          <span class="t-meta">{site.lightReportShort}</span>
        </p>
      </div>
    </div>
  </div>
</header>

<script>
  function initNav() {
    const nav = document.getElementById("nav")
    const toggle = document.getElementById("nav-toggle")
    const drawer = document.getElementById("nav-drawer")
    if (!nav || !toggle || !drawer || nav.dataset.bound) return
    nav.dataset.bound = "1"
    let open = false
    let last = window.scrollY

    const setOpen = (v: boolean) => {
      open = v
      drawer.style.gridTemplateRows = open ? "1fr" : "0fr"
      toggle.textContent = open ? "Close" : "Menu"
      toggle.setAttribute("aria-expanded", String(open))
      document.body.style.overflow = open ? "hidden" : ""
    }
    toggle.addEventListener("click", () => setOpen(!open))
    drawer.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)))

    // Framer "Hidden" variants: the bar fades out while scrolling down and back in on the way up.
    window.addEventListener(
      "scroll",
      () => {
        const y = window.scrollY
        const hide = y > last && y > 180 && !open
        nav.style.opacity = hide ? "0" : "1"
        nav.style.pointerEvents = hide ? "none" : ""
        last = y
      },
      { passive: true }
    )
  }

  initNav()
  document.addEventListener("astro:page-load", initNav)
</script>
