---
/** Framer "Rates" + "Plan Card". Card fill white/4% (hover 7%), featured 8.5% with a blue label. */
import Words from "./Words.astro"
import Button from "./Button.astro"
import { rates } from "@/data/content"
interface Props { pad?: "home" | "journal" | "studio" }
const { pad = "home" } = Astro.props
/** Framer pads this band differently on each page (phone / tablet / desktop). */
const pads = { home: "px-5 py-10 md:px-6 md:py-20 lg:px-12 lg:pb-[100px] lg:pt-[60px]", journal: "px-5 py-10 md:px-6 md:py-20 lg:px-12 lg:py-32", studio: "px-5 pb-12 pt-20 md:px-8 md:py-24 lg:px-12 lg:py-32" }
---
<section id="rates" class={`on-dark bg-dusk ${pads[pad]}`} data-reveal>
  <div class="mx-auto flex max-w-[1536px] flex-col gap-10 md:gap-12 lg:gap-16">
    <div class="flex flex-col gap-4 lg:gap-6" data-reveal="rise">
      <p class="t-meta accent">{rates.eyebrow}</p>
      <h2 class="flex flex-wrap items-end gap-x-2 gap-y-1 md:gap-x-3 lg:gap-x-4">
        <span class="t-l"><Words text={rates.title[0]} /></span>
        <span class="t-l-serif"><Words text={rates.title[1]} /></span>
        <span class="t-l"><Words text={rates.title[2]} /></span>
      </h2>
    </div>
    <ul class="grid gap-5 lg:grid-cols-3 lg:gap-x-8 lg:gap-y-12">
      {rates.plans.map((p: any) => (
        <li class={`flex h-full flex-col gap-5 rounded-[4px] transition-colors duration-[350ms] ease-[cubic-bezier(0.22,1,0.36,1)] ${p.featured ? "bg-white/[0.085] px-4 pb-9 pt-[42px] md:px-[30px]" : "bg-white/[0.04] px-4 pb-[30px] pt-[34px] hover:bg-white/[0.07] md:px-[30px]"}`}>
          <p class={`t-meta ${p.featured ? "!text-bluenight" : "!text-white/45"}`}>{p.eyebrow}</p>
          <h3 class="t-m">{p.title}</h3>
          <p class="t-body">{p.description}</p>
          <div class="flex flex-col gap-2 pt-1">
            <p class="tnum text-[44px] font-light leading-none tracking-[-0.03em]">{p.price}</p>
            <p class="t-meta !text-white/40">{p.priceNote}</p>
          </div>
          <ul class="border-t border-white/[0.09] pt-5">
            {p.includes.map((line: string) => (
              <li class="flex items-center gap-3 border-b border-white/[0.06] py-2.5">
                <svg aria-hidden="true" viewBox="0 0 16 16" class="h-4 w-4 shrink-0"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span class="t-small flex-1 !text-white/70">{line}</span>
              </li>
            ))}
          </ul>
          <Button href="/contact" variant={p.featured ? "light" : "ghostDark"} class="mt-auto w-full">Enquire →</Button>
        </li>
      ))}
    </ul>
  </div>
</section>
