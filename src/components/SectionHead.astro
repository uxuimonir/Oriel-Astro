---
import Words from "./Words.astro"
interface Props { eyebrow?: string; title: string[]; body?: string; dark?: boolean; accent?: boolean; level?: "h1" | "h2" }
const { eyebrow, title, body, dark = false, accent = false, level = "h2" } = Astro.props
const Head = level as any
---
<div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
  <div class="max-w-[760px]">
    {eyebrow && <p class={`t-meta ${accent ? "text-blue" : dark ? "text-ashnight" : "text-ash"}`}>{eyebrow}</p>}
    <Head class={`t-l mt-5 ${dark ? "text-ondark" : ""}`}>
      <Words text={title[0]} />{" "}
      <span class="t-l-serif italic"><Words text={title[1]} /></span>
    </Head>
  </div>
  {body && <p class={`t-body w-full max-w-[340px] ${dark ? "text-ashnight" : "text-ash"}`}>{body}</p>}
</div>
