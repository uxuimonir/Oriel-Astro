---
import Words from "./Words.astro"
import ProjectCard from "./ProjectCard.astro"
import Button from "./Button.astro"
import { projects, work } from "@/data/content"
const [p1, p2, p3, p4, p5, p6] = projects
const half = "(min-width:810px) 50vw, 100vw"
---
<section class="px-5 pb-8 pt-6 md:px-6 md:pb-16 md:pt-12 lg:px-12 lg:py-[100px]">
  <div class="mx-auto flex max-w-[1536px] flex-col gap-8 md:gap-10 lg:gap-[70px]" data-reveal>
    <div class="flex flex-col gap-4 md:gap-6 lg:flex-row lg:flex-wrap lg:items-end lg:justify-between lg:gap-10" data-reveal="rise">
      <div class="flex max-w-[760px] flex-col gap-4 lg:gap-6">
        <p class="t-meta accent">{work.eyebrow}</p>
        <h2 class="flex flex-col gap-1">
          <span class="t-l"><Words text={work.title[0]} /></span>
          <span class="flex flex-wrap items-end gap-2 md:gap-3 lg:gap-4">
            <span class="t-l-serif"><Words text={work.title[1]} /></span>
            <span class="t-l"><Words text={work.title[2]} /></span>
          </span>
        </h2>
      </div>
      <p class="t-small max-w-[520px] lg:w-[340px]">{work.body}</p>
    </div>

    <div class="flex flex-col gap-10 md:gap-16 lg:gap-14">
      <div class="flex flex-col gap-10 md:flex-row md:gap-8 lg:gap-12">
        <div class="md:flex-1"><ProjectCard project={p1} shape="portrait" sizes={half} /></div>
        <div class="md:flex-1 lg:pt-[120px]"><ProjectCard project={p2} shape="landscape" sizes={half} /></div>
      </div>
      <ProjectCard project={p3} shape="feature" sizes="100vw" />
      <div class="flex flex-col gap-10 md:flex-row md:items-start md:gap-8 lg:items-center lg:gap-12">
        <div class="md:flex-1"><ProjectCard project={p4} shape="landscape" sizes={half} /></div>
        <div class="md:flex-1"><ProjectCard project={p6} shape="portrait" sizes={half} /></div>
      </div>
      <ProjectCard project={p5} shape="feature" sizes="100vw" />
    </div>

    <div class="flex justify-center">
      <Button href="/work">{work.indexLink}</Button>
    </div>
  </div>
</section>
