---
import Frame from "./Frame.astro"
import Reveal from "./Reveal.astro"
import { statement } from "@/data/content"
---
<section class="band">
  <div class="shell">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_0.9fr]">
      <Reveal>
        <p class="t-meta text-ash">{statement.eyebrow}</p>
        <p class="t-m mt-6 max-w-[22ch]">{statement.body}</p>
      </Reveal>
      <Reveal as="figure" delay={0.08}>
        <Frame src={statement.image} alt={statement.alt} class="aspect-[4/5] w-full" sizes="(min-width:1200px) 30vw, 100vw" />
        <figcaption class="t-meta mt-3 text-ash">{statement.caption}</figcaption>
      </Reveal>
    </div>

    <ul class="rule mt-16 grid gap-10 pt-10 sm:grid-cols-3">
      {statement.stats.map((s, i) => (
        <li data-reveal style={`--reveal-delay:${(i * 0.1).toFixed(2)}s`}>
          <p class="t-l tnum" data-count={s.figure}>{s.figure}</p>
          <p class="t-small mt-2 max-w-[22ch] text-ash">{s.label}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
