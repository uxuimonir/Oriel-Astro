---
import Frame from "./Frame.astro"
import Words from "./Words.astro"
import { statement } from "@/data/content"
---
<section class="px-5 py-8 md:px-6 md:py-16 lg:h-[880px] lg:px-12 lg:py-32">
  <div class="mx-auto flex max-w-[1536px] flex-col gap-10 md:flex-row md:flex-wrap md:gap-12 lg:gap-16" data-reveal>
    <div class="flex flex-col gap-4 md:flex-1 lg:gap-6" data-reveal="rise">
      <p class="t-meta accent">{statement.eyebrow}</p>
      <p class="t-m"><Words text={statement.body} /></p>
    </div>
    <figure class="flex flex-col gap-3 md:w-[280px] lg:w-[360px]">
      <Frame src={statement.image} alt={statement.alt} class="h-[420px] w-full md:h-[350px] lg:h-[450px]" style="--frame-from:1.03;--frame-dur:1.1s" sizes="(min-width:810px) 360px, 100vw" />
      <figcaption class="t-meta">{statement.caption}</figcaption>
    </figure>
    <ul class="flex w-full flex-col gap-5 md:flex-row md:gap-0 md:border-t md:border-hairline">
      {statement.stats.map((s, i) => (
        <li class={`flex min-w-0 flex-1 flex-col gap-2.5 border-t border-hairline pt-4 md:border-t-0 md:pr-6 md:pt-7 ${i ? "md:border-l md:pl-8" : ""}`}>
          <p class="t-m tnum" data-count={s.figure}>{s.figure}</p>
          <p class="t-meta">{s.label}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
