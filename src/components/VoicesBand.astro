---
import SectionHead from "./SectionHead.astro"
import Frame from "./Frame.astro"
import { voices } from "@/data/content"
---
<section class="band bg-dusk text-ondark">
  <div class="shell">
    <SectionHead eyebrow={voices.eyebrow} title={voices.title} body={voices.body} dark />
    <ul class="mt-12 grid gap-x-10 gap-y-12 sm:grid-cols-2 md:mt-16 lg:gap-x-16">
      {voices.quotes.map((q, i) => (
        <li data-reveal style={`--reveal-delay:${(i * 0.09).toFixed(2)}s`}>
          <figure>
            <Frame src={q.portrait} alt="" class="aspect-[4/3] w-[72px]" sizes="72px" />
            <blockquote class="t-body mt-5 max-w-[34ch] text-ondark/90">{q.quote}</blockquote>
            <figcaption class="mt-5">
              <span class="t-small block">{q.name}</span>
              <span class="t-meta mt-1 block text-ashnight">{q.role}</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
