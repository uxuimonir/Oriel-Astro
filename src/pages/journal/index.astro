---
import Base from "@/layouts/Base.astro"
import Words from "@/components/Words.astro"
import JournalFeature from "@/components/JournalFeature.astro"
import JournalCard from "@/components/JournalCard.astro"
import VoicesBand from "@/components/VoicesBand.astro"
import ContactBand from "@/components/ContactBand.astro"
import { journal, posts } from "@/data/content"

const bySlug = new Map(posts.map((p) => [p.slug, p]))
const featured = bySlug.get(journal.featuredSlug)!
const grid = journal.gridSlugs.map((s) => bySlug.get(s)!).filter(Boolean)
---
<Base
  title="Journal — Notes from the waiting | Oriel"
  description="Field notes, craft and the odd essay by photographer Mira Castell, written on location — usually while nothing was happening."
  image={featured.cover}
>
  <section class="px-5 pb-5 pt-[72px] md:px-6 md:pb-6 md:pt-[88px] lg:px-12 lg:pb-16 lg:pt-24" data-reveal="rise">
    <div class="mx-auto flex max-w-[1536px] flex-col gap-4 lg:gap-6" data-reveal>
      <p class="t-meta accent">{journal.eyebrow}</p>
      <h1 class="flex flex-col">
        <span class="t-xl"><Words text={journal.title[0]} /></span>
        <span class="t-l-serif"><Words text={journal.title[1]} /></span>
      </h1>
      <p class="t-small max-w-[684px] md:w-[57%]">{journal.bodyIndex}</p>
    </div>
  </section>

  <section class="px-5 pb-8 pt-4 md:px-6 md:pb-16 md:pt-5 lg:px-12 lg:pb-32 lg:pt-6">
    <div class="mx-auto flex max-w-[1536px] flex-col gap-16 lg:gap-24" data-reveal>
      <JournalFeature post={featured} />
      <ul class="grid gap-y-12 md:grid-cols-2 md:gap-x-8 md:gap-y-14 lg:gap-x-10 lg:gap-y-[72px]">
        {grid.map((p, i) => <JournalCard post={p} delay={Number(((i % 2) * 0.08).toFixed(2))} />)}
      </ul>
    </div>
  </section>

  <VoicesBand pad="journal" />
  <ContactBand variant="spacious" />
</Base>
