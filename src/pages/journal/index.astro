---
import Base from "@/layouts/Base.astro"
import Words from "@/components/Words.astro"
import JournalFeature from "@/components/JournalFeature.astro"
import JournalCard from "@/components/JournalCard.astro"
import VoicesBand from "@/components/VoicesBand.astro"
import ContactBand from "@/components/ContactBand.astro"
import { journal, posts } from "@/data/content"

const bySlug = new Map(posts.map((p) => [p.slug, p]))
const featured = bySlug.get(journal.featuredSlug)!
const grid = journal.gridSlugs.map((s) => bySlug.get(s)!).filter(Boolean)
---
<Base
  title="Journal — Notes from the waiting | Oriel"
  description="Field notes, craft and the odd essay by photographer Mira Castell, written on location — usually while nothing was happening."
  image={featured.cover}
>
  <section class="pt-10 md:pt-16">
    <div class="shell">
      <p class="t-meta text-ash">{journal.eyebrow}</p>
      <h1 class="t-l mt-5">
        <span class="block"><Words text={journal.title[0]} /></span>
        <span class="t-l-serif block italic"><Words text={journal.title[1]} /></span>
      </h1>
      <p class="t-small mt-6 max-w-[62ch] text-ash">{journal.bodyIndex}</p>
    </div>
  </section>

  <section class="pb-[72px] pt-10 md:pb-[120px] md:pt-14">
    <div class="shell">
      <JournalFeature post={featured} />

      <ul class="mt-14 grid grid-cols-2 gap-x-6 gap-y-12 md:mt-20 md:gap-x-8 md:gap-y-16">
        {grid.map((p, i) => (
          <JournalCard post={p} delay={Number(((i % 2) * 0.08).toFixed(2))} />
        ))}
      </ul>
    </div>
  </section>

  <VoicesBand />
  <ContactBand />
</Base>
