---
import Base from "@/layouts/Base.astro"
import Words from "@/components/Words.astro"
import Frame from "@/components/Frame.astro"
import AboutBand from "@/components/AboutBand.astro"
import CommissionsBand from "@/components/CommissionsBand.astro"
import VoicesBand from "@/components/VoicesBand.astro"
import RatesBand from "@/components/RatesBand.astro"
import FaqBand from "@/components/FaqBand.astro"
import ContactBand from "@/components/ContactBand.astro"
import { studioHero } from "@/data/content"
---
<Base
  title="Studio — About Mira Castell, rates and process | Oriel"
  description="Oriel is Mira Castell: portraits, places and weather in natural light for magazines, architects, hotels and brands. Process, commissions, rates and FAQ."
  image={studioHero.image}
>
  <section class="pb-12 pt-10 md:pb-16 md:pt-16">
    <div class="shell">
      <p class="t-meta text-ash">{studioHero.eyebrow}</p>
      <h1 class="t-l mt-5 max-w-[16ch]">
        <Words text={studioHero.title[0]} />{" "}
        <span class="t-l-serif italic"><Words text={studioHero.title[1]} /></span>
      </h1>

      <div class="mt-10 grid gap-10 lg:grid-cols-[1fr_1fr] lg:gap-16">
        <p class="t-small max-w-[48ch] text-ash">{studioHero.body}</p>
        <ul class="grid gap-x-8 gap-y-6 sm:grid-cols-2">
          {studioHero.facts.map(([k, v], i) => (
            <li class="rule pt-3" data-reveal style={`--reveal-delay:${(i * 0.07).toFixed(2)}s`}>
              <p class="t-meta text-ash">{k}</p>
              <p class="t-small mt-2 max-w-[30ch]">{v}</p>
            </li>
          ))}
        </ul>
      </div>

      <figure class="mt-12 md:mt-16">
        <Frame src={studioHero.image} alt={studioHero.alt} eager class="aspect-[16/9] w-full" sizes="100vw" />
        <figcaption class="t-meta mt-3 text-ash">{studioHero.caption}</figcaption>
      </figure>
    </div>
  </section>

  <AboutBand />
  <CommissionsBand />
  <VoicesBand />
  <RatesBand />
  <FaqBand />
  <ContactBand />
</Base>
