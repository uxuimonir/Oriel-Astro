---
import Base from "@/layouts/Base.astro"
import Words from "@/components/Words.astro"
import Frame from "@/components/Frame.astro"
import AboutBand from "@/components/AboutBand.astro"
import CommissionsBand from "@/components/CommissionsBand.astro"
import VoicesBand from "@/components/VoicesBand.astro"
import RatesBand from "@/components/RatesBand.astro"
import FaqBand from "@/components/FaqBand.astro"
import ContactBand from "@/components/ContactBand.astro"
import { studioHero } from "@/data/content"
---
<Base
  title="Studio — About Mira Castell, rates and process | Oriel"
  description="Oriel is Mira Castell: portraits, places and weather in natural light for magazines, architects, hotels and brands. Process, commissions, rates and FAQ."
  image={studioHero.image}
>
  <section class="px-5 pb-4 pt-[72px] md:px-6 md:pb-10 md:pt-[88px] lg:px-12 lg:py-24">
    <div class="mx-auto flex max-w-[1536px] flex-col gap-8 lg:gap-12" data-reveal>
      <p class="t-meta accent" data-reveal="rise">{studioHero.eyebrow}</p>
      <h1 class="flex flex-col" data-reveal="rise">
        <span class="t-hero"><Words text={studioHero.title[0]} /></span>
        <span class="flex flex-wrap items-end gap-3 md:gap-5 lg:gap-6">
          <span class="t-hero">{studioHero.title[1]}</span>
          <span class="t-hero-serif">{studioHero.title[2]}</span>
        </span>
      </h1>
      <div class="flex flex-col gap-8 lg:flex-row lg:gap-12" data-reveal="rise">
        <p class="t-lead lg:flex-1">{studioHero.body}</p>
        <div class="grid grid-cols-2 gap-x-10 gap-y-5 md:max-w-[320px] lg:max-w-none lg:px-[59px]">
          {studioHero.facts.map(([k, v]) => (
            <div class="flex flex-col gap-2 border-t border-hairline pt-4">
              <p class={`t-meta ${k === "Next opening" ? "accent" : ""}`}>{k}</p>
              <p class="t-small">{v}</p>
            </div>
          ))}
        </div>
      </div>
      <figure class="flex flex-col gap-3">
        <Frame src={studioHero.image} alt={studioHero.alt} eager class="aspect-[1.78] w-full" style="--frame-from:1.04;--frame-dur:1.1s" sizes="100vw" />
        <figcaption class="t-meta">{studioHero.caption}</figcaption>
      </figure>
    </div>
  </section>

  <AboutBand pad="studio" />
  <CommissionsBand pad="studio" />
  <VoicesBand pad="studio" />
  <RatesBand pad="studio" />
  <FaqBand pad="studio" />
  <ContactBand variant="studio" />
</Base>
