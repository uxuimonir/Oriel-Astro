---
import Base from "@/layouts/Base.astro"
import Words from "@/components/Words.astro"
import Frame from "@/components/Frame.astro"
import Button from "@/components/Button.astro"
import { projects } from "@/data/content"

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }))
}
const { project: p } = Astro.props
const [feature, establishing, detail, wide, motion, quiet, closing] = p.images
const pad = "px-5 md:px-6 lg:px-12"
const facts = [["Year", p.year], ["Location", p.location], ["Hours", p.hours], ["Client", p.client]]
const slow = "--frame-from:1.03;--frame-dur:1.1s"
---
<Base title={`${p.title} | Oriel`} description={p.intro} image={feature.src}>
  <article style={`--tint:${p.tint}`}>
    <!-- Project hero + cover sit on the series tint -->
    <section class={`bg-[var(--tint)] ${pad} pb-4 pt-[72px] md:pb-8 md:pt-[88px] lg:pb-16 lg:pt-24`}>
      <div class="mx-auto flex max-w-[1536px] flex-col gap-8 lg:gap-12" data-reveal>
        <div class="flex flex-wrap items-center justify-between gap-4" data-reveal="rise">
          <p class="t-meta accent">{p.number}</p>
          <p class="t-meta">{p.meta}</p>
        </div>
        <h1 class="t-hero" data-reveal="rise"><Words text={p.title} /></h1>
        <dl class="grid grid-cols-2 gap-4 lg:grid-cols-4 lg:gap-6" data-reveal="rise">
          {facts.map(([k, v]) => (
            <div class="flex flex-col gap-2 border-t border-hairline pt-4">
              <dt class="t-meta">{k}</dt>
              <dd class="t-small">{v}</dd>
            </div>
          ))}
        </dl>
        <div class="flex flex-col gap-6 md:flex-row md:gap-8 lg:gap-16" data-reveal="rise">
          <p class="t-lead md:flex-1">{p.intro}</p>
          <p class="t-body md:flex-[1.4]">{p.body}</p>
        </div>
      </div>
    </section>

    <section class={`bg-[var(--tint)] ${pad} pb-4 md:pb-10 lg:pb-24 lg:pt-12`} data-reveal>
      <figure class="mx-auto flex max-w-[660px] flex-col gap-3">
        <Frame src={feature.src} alt={feature.caption} eager class="aspect-[0.8] w-full" sizes="(min-width:810px) 660px, 100vw" />
        <figcaption class="t-meta">{feature.caption}</figcaption>
      </figure>
    </section>

    <!-- Sequence: bleed, offset, text, full, bleed, small -->
    <section class="pb-6 pt-4 md:pb-12 md:pt-10 lg:pb-[120px] lg:pt-24">
      <div class="mx-auto flex max-w-[1536px] flex-col items-center gap-16 lg:gap-24" data-reveal>
        <figure class="flex w-full flex-col gap-3">
          <Frame src={establishing.src} alt={establishing.caption} class="aspect-[1.15] w-full md:aspect-[1.8] lg:aspect-[2.33]" sizes="100vw" />
          <figcaption class={`t-meta ${pad}`}>{establishing.caption}</figcaption>
        </figure>

        <div class={`flex w-full flex-col items-start gap-4 md:flex-row md:items-end md:gap-8 lg:gap-12 ${pad}`}>
          <p class="t-lead pb-4 md:flex-1 lg:pb-6">{p.aside}</p>
          <figure class="flex w-full flex-col gap-3 md:w-[58%]">
            <Frame src={detail.src} alt={detail.caption} class="aspect-square w-full" style={slow} sizes="(min-width:810px) 58vw, 100vw" />
            <figcaption class="t-meta">{detail.caption}</figcaption>
          </figure>
        </div>

        <div class={`flex w-full flex-col gap-6 py-4 md:flex-row md:gap-8 lg:gap-16 lg:py-6 ${pad}`} data-reveal="rise">
          <p class="t-m md:flex-1"><Words text={p.quote} /></p>
          <div class="flex flex-col gap-4 md:flex-[1.2]">
            <p class="t-body">{p.body2}</p>
            {p.body3 && <p class="t-body">{p.body3}</p>}
          </div>
        </div>

        <figure class={`flex w-full flex-col gap-3 ${pad}`}>
          <Frame src={wide.src} alt={wide.caption} class="aspect-[1.5] w-full" style={slow} sizes="100vw" />
          <figcaption class="t-meta">{wide.caption}</figcaption>
        </figure>

        <figure class="flex w-full flex-col gap-3">
          <Frame src={motion.src} alt={motion.caption} class="aspect-[1.78] w-full" sizes="100vw" />
          <figcaption class={`t-meta ${pad}`}>{motion.caption}</figcaption>
        </figure>

        <div class={`flex w-full justify-center ${pad}`}>
          <figure class="flex w-full max-w-[440px] flex-col gap-3">
            <Frame src={quiet.src} alt={quiet.caption} class="aspect-[0.8] w-full" style={slow} sizes="440px" />
            <figcaption class="t-meta">{quiet.caption}</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class={`bg-stone ${pad} py-8 md:py-12 lg:py-24`} data-reveal>
      <div class="mx-auto flex max-w-[1536px] flex-col gap-10 md:flex-row md:gap-12 lg:gap-16">
        <div class="flex flex-col gap-4 md:flex-1">
          <p class="t-meta accent">Credits</p>
          <h2 class="t-m"><Words text="Made by" /></h2>
        </div>
        <dl class="flex flex-col md:flex-[1.6]">
          {p.credits.map(([k, v]) => (
            <div class="flex flex-col gap-4 border-t border-hairline py-4 md:flex-row md:flex-wrap lg:gap-6">
              <dt class="t-meta md:w-40">{k}</dt>
              <dd class="t-small flex-1">{v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class={`${pad} py-4 md:py-5 lg:py-10`} data-reveal>
      <div class="mx-auto w-full max-w-[600px]">
        <Frame src={closing.src} alt={closing.caption} class="aspect-[0.75] w-full" style={slow} sizes="600px" />
      </div>
    </section>

    <section class={`${pad} pb-8 pt-6 md:pb-16 md:pt-12 lg:pb-32 lg:pt-[120px]`} data-reveal="rise">
      <div class="mx-auto flex max-w-[1536px] flex-col justify-between gap-10 md:flex-row md:flex-wrap md:items-end" data-reveal>
        <div class="flex flex-col gap-4">
          <p class="t-meta">{p.next.number}</p>
          <a href={`/work/${p.next.slug}`} class="t-xl card-title block transition-colors hover:text-blue md:w-[562px]"><Words text={p.next.title} /></a>
        </div>
        <div class="flex flex-col items-start gap-4">
          <Button href="/work">All frames →</Button>
          <Button href="/contact">Commission a series →</Button>
        </div>
      </div>
    </section>
  </article>
</Base>
