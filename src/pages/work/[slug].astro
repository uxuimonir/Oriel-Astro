---
import Base from "@/layouts/Base.astro"
import Words from "@/components/Words.astro"
import Frame from "@/components/Frame.astro"
import ContactBand from "@/components/ContactBand.astro"
import { projects } from "@/data/content"

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }))
}
const { project: p } = Astro.props
const [opening, establishing, detail, wide, motion, quiet, closing] = p.images
---
<Base title={`${p.title} | Oriel`} description={p.intro} image={opening.src}>
  <article>
    <section class="band pt-10 md:pt-16">
      <div class="shell">
        <p class="t-meta text-blue">{p.number}</p>
        <h1 class="t-hero mt-6 max-w-[12ch]"><Words text={p.title} /></h1>

        <div class="mt-12 grid gap-12 lg:grid-cols-[1.2fr_0.8fr]">
          <div>
            <p class="t-lead max-w-[50ch]">{p.intro}</p>
            <p class="t-body mt-8 max-w-[62ch] text-ash">{p.body}</p>
          </div>
          <ul class="grid h-fit gap-x-8 gap-y-6 sm:grid-cols-2">
            {[["Year", p.year], ["Location", p.location], ["Hours", p.hours], ["Client", p.client]].map(([k, v], i) => (
              <li class="rule pt-4" data-reveal style={`--reveal-delay:${(i * 0.07).toFixed(2)}s`}>
                <p class="t-meta text-ash">{k}</p>
                <p class="t-small mt-2">{v}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="pb-16 md:pb-24">
      <div class="shell">
        <figure>
          <Frame src={opening.src} alt={opening.caption} eager class="aspect-[16/10] w-full" sizes="100vw" />
          <figcaption class="t-meta mt-3 text-ash">{opening.caption}</figcaption>
        </figure>
      </div>
    </section>

    <section class="pb-16 md:pb-24">
      <div class="shell flex flex-col gap-[clamp(56px,7vw,96px)]">
        <div class="grid gap-10 lg:grid-cols-[1.4fr_0.9fr] lg:items-end">
          <figure>
            <Frame src={establishing.src} alt={establishing.caption} class="aspect-[3/2] w-full" sizes="(min-width:1200px) 60vw, 100vw" />
            <figcaption class="t-meta mt-3 text-ash">{establishing.caption}</figcaption>
          </figure>
          <p class="t-small max-w-[40ch] text-ash">{p.aside}</p>
        </div>

        <blockquote class="t-quote mx-auto max-w-[18ch] text-center italic">{p.quote}</blockquote>

        <div class="grid gap-10 lg:grid-cols-2 lg:items-start">
          <figure>
            <Frame src={detail.src} alt={detail.caption} class="aspect-[4/5] w-full" sizes="(min-width:1200px) 45vw, 100vw" />
            <figcaption class="t-meta mt-3 text-ash">{detail.caption}</figcaption>
          </figure>
          <div class="lg:pt-24">
            <p class="t-body max-w-[52ch] text-ash">{p.body2}</p>
            {p.body3 && <p class="t-body mt-6 max-w-[52ch] text-ash">{p.body3}</p>}
          </div>
        </div>

        <figure>
          <Frame src={wide.src} alt={wide.caption} class="aspect-[21/9] w-full" sizes="100vw" />
          <figcaption class="t-meta mt-3 text-ash">{wide.caption}</figcaption>
        </figure>

        <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
          <figure>
            <Frame src={quiet.src} alt={quiet.caption} class="aspect-[4/5] w-full" sizes="(min-width:1200px) 40vw, 100vw" />
            <figcaption class="t-meta mt-3 text-ash">{quiet.caption}</figcaption>
          </figure>
          <figure>
            <Frame src={motion.src} alt={motion.caption} class="aspect-[3/2] w-full" sizes="(min-width:1200px) 55vw, 100vw" />
            <figcaption class="t-meta mt-3 text-ash">{motion.caption}</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="band bg-stone/50">
      <div class="shell">
        <p class="t-meta text-ash">Credits</p>
        <h2 class="t-l mt-5">Made by</h2>
        <ul class="mt-10 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
          {p.credits.map(([k, v], i) => (
            <li class="rule pt-4" data-reveal style={`--reveal-delay:${(i * 0.07).toFixed(2)}s`}>
              <p class="t-meta text-ash">{k}</p>
              <p class="t-small mt-2">{v}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section>
      <Frame src={closing.src} alt={closing.caption} hover={false} class="h-[60vh] min-h-[360px] w-full" sizes="100vw" />
    </section>

    <section class="band">
      <div class="shell flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
        <div>
          <p class="t-meta text-ash">{p.next.number}</p>
          <a href={`/work/${p.next.slug}`} class="t-l mt-4 inline-block transition-colors hover:text-blue">{p.next.title}</a>
        </div>
        <a href="/work" class="t-small border-b border-current pb-1 transition-colors hover:text-blue">Every frame, in one index →</a>
      </div>
    </section>
  </article>

  <ContactBand />
</Base>
