---
import Base from "@/layouts/Base.astro"
import Words from "@/components/Words.astro"
import Frame from "@/components/Frame.astro"
import CommissionsBand from "@/components/CommissionsBand.astro"
import ContactBand from "@/components/ContactBand.astro"
import { projects, workIndex } from "@/data/content"

/** Desktop column spans of the seven frames in one contact sheet: 3 up, then 4. */
const spans = [
  "md:col-span-4", "md:col-span-5", "md:col-span-3",
  "md:col-span-3", "md:col-span-3", "md:col-span-3", "md:col-span-3",
]
/** Phone keeps each frame's own ratio; from tablet up the sheet reads as two even strips. */
const ratio = (r: string, i: number) => {
  const own = r === "portrait" ? "aspect-[4/5]" : r === "square" ? "aspect-square" : "aspect-[3/2]"
  const strip = i < 3 ? "md:aspect-auto md:h-[200px] lg:h-[260px]" : "md:aspect-auto md:h-[170px] lg:h-[210px]"
  return `${own} ${strip}`
}
const chips = ["All", ...projects.map((p) => `${p.code.replace("N°", "")} ${p.title}`)]
---
<Base
  title="Work — Every frame, in order | Oriel"
  description="Six series and 42 frames from 2023–2025: portraits, places and weather by Mira Castell, every photograph at its own ratio, numbered like film."
  image={projects[0].images[0].src}
>
  <section class="pt-10 md:pt-16">
    <div class="shell">
      <p class="t-meta text-ash">{workIndex.eyebrow}</p>
      <h1 class="t-l mt-5 max-w-[12ch]">
        <Words text={workIndex.title[0]} />{" "}
        <span class="t-l-serif italic"><Words text={workIndex.title[1]} /></span>
      </h1>
      <p class="t-small mt-6 max-w-[56ch] text-ash">{workIndex.body}</p>

      <ul class="mt-9 flex flex-wrap gap-2" role="list">
        {chips.map((f, i) => (
          <li>
            <button
              type="button"
              class="t-meta rounded-full border border-hairline px-4 py-2 transition-colors duration-300 hover:border-basalt hover:text-blue data-[active]:border-basalt data-[active]:bg-basalt data-[active]:text-salt"
              data-filter={i === 0 ? "all" : projects[i - 1].slug}
              data-active={i === 0 ? "" : undefined}
            >{f}</button>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="pb-[72px] pt-12 md:pb-[120px] md:pt-16">
    <div class="shell space-y-16 md:space-y-24">
      {projects.map((p) => (
        <section data-series={p.slug} aria-labelledby={`series-${p.slug}`} class="scroll-mt-24">
          <div class="rule flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 pt-4">
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
              <span class="t-meta text-blue">{p.code}</span>
              <h2 id={`series-${p.slug}`} class="t-m text-[24px] md:text-[28px] lg:text-[32px]">{p.title}</h2>
              <span class="t-meta text-ash">{p.kind} · {p.year}</span>
            </div>
            <a href={`/work/${p.slug}`} class="t-meta border-b border-current pb-1 transition-colors duration-300 hover:text-blue">Open series →</a>
          </div>

          <ul class="mt-6 grid grid-cols-2 gap-x-4 gap-y-8 md:mt-8 md:grid-cols-12 md:gap-x-6 md:gap-y-10" data-sheet>
            {p.images.map((im, i) => (
              <li class={spans[i]} data-reveal style={`--reveal-delay:${((i % 4) * 0.06).toFixed(2)}s`}>
                <a href={`/work/${p.slug}`} class="group block">
                  <Frame
                    src={im.src}
                    alt={im.caption}
                    class={`w-full ${ratio(im.ratio, i)}`}
                    eager={i < 3}
                    sizes="(min-width:1200px) 25vw, (min-width:810px) 33vw, 50vw"
                  />
                  <p class="t-meta mt-3 text-ash transition-colors group-hover:text-blue">{im.label}</p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>

  <CommissionsBand />
  <ContactBand />
</Base>

<script>
  function initFilters() {
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]")
    const blocks = document.querySelectorAll<HTMLElement>("[data-series]")
    buttons.forEach((b) =>
      b.addEventListener("click", () => {
        const value = b.dataset.filter!
        buttons.forEach((x) => x.removeAttribute("data-active"))
        b.setAttribute("data-active", "")
        blocks.forEach((block) => {
          block.hidden = !(value === "all" || block.dataset.series === value)
        })
        if (value !== "all") {
          const target = document.querySelector<HTMLElement>(`[data-series="${value}"]`)
          target?.scrollIntoView({ behavior: "smooth", block: "start" })
        }
      })
    )
  }
  initFilters()
  document.addEventListener("astro:page-load", initFilters)
</script>
