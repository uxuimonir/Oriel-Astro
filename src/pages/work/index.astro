---
import Base from "@/layouts/Base.astro"
import Words from "@/components/Words.astro"
import Frame from "@/components/Frame.astro"
import CommissionsBand from "@/components/CommissionsBand.astro"
import ContactBand from "@/components/ContactBand.astro"
import { projects, workIndex } from "@/data/content"

/** Framer "Contact Frame": every image is 200px tall; width + ratio per frame role (Opening … Closing). */
/** w / wt: desktop and tablet widths. ar: ratio; arp: the ratio Framer switches to on phone. */
const frames = [
  { w: 160, wt: 106, ar: "0.8", arp: "0.8" }, { w: 466, wt: 308, ar: "2.33", arp: "0.8" }, { w: 200, wt: 132, ar: "1", arp: "1" },
  { w: 300, wt: 198, ar: "1.5", arp: "1" }, { w: 356, wt: 235, ar: "1.78", arp: "0.8" }, { w: 160, wt: 106, ar: "0.8", arp: "0.8" },
  { w: 150, wt: 99, ar: "0.75", arp: "0.75" },
]
const chips = ["All", ...projects.map((p) => `${p.code.replace("N°", "")} ${p.title}`)]
---
<Base
  title="Work — Every frame, in order | Oriel"
  description="Six series and 42 frames from 2023–2025: portraits, places and weather by Mira Castell, every photograph at its own ratio, numbered like film."
  image={projects[0].images[0].src}
>
  <section class="px-5 pb-5 pt-[72px] md:px-6 md:pb-6 md:pt-[88px] lg:px-12 lg:pb-16 lg:pt-24">
    <div class="mx-auto flex max-w-[1536px] flex-col gap-4 lg:gap-6" data-reveal>
      <p class="t-meta accent">{workIndex.eyebrow}</p>
      <h1 class="flex flex-col">
        <span class="t-xl"><Words text={workIndex.title[0]} /></span>
        <span class="t-l-serif"><Words text={workIndex.title[1]} /></span>
      </h1>
      <p class="t-small max-w-[560px]">{workIndex.body}</p>
      <ul class="flex flex-wrap gap-2" role="list">
        {chips.map((f, i) => (
          <li>
            <button
              type="button"
              class="chip t-meta rounded-full border border-hairline px-4 py-2 transition-colors duration-300"
              data-filter={i === 0 ? "all" : projects[i - 1].slug}
              data-active={i === 0 ? "" : undefined}
            >{f}</button>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="px-5 pb-[100px] pt-6 md:px-6 lg:px-12">
    <div class="mx-auto flex max-w-[1536px] flex-col">
      {projects.map((p) => (
        <section data-series={p.slug} aria-labelledby={`series-${p.slug}`} class="flex flex-col gap-4 pb-1 lg:gap-6">
          <div class="flex flex-col items-start gap-4 border-t border-hairline pt-4 md:flex-row md:flex-wrap md:items-center md:justify-between" data-reveal="rise">
            <div class="flex flex-1 flex-wrap items-center gap-4">
              <span class="t-meta accent">{p.code}</span>
              <h2 id={`series-${p.slug}`} class="t-lead">{p.title}</h2>
              <span class="t-meta">{p.kind} · {p.year}</span>
            </div>
            <a href={`/work/${p.slug}`} class="btn t-button border-b border-blue py-1.5"><span class="btn-label">Open series →</span></a>
          </div>

          <ul class="sheet flex flex-wrap items-end gap-4 lg:gap-6" data-sheet>
            {p.images.map((im, i) => (
              <li class="sheet-frame flex flex-col gap-2" style={`--w:${frames[i].w}px;--wt:${frames[i].wt}px;--ar:${frames[i].ar};--arp:${frames[i].arp}`}>
                <a href={`/work/${p.slug}`} class="group flex flex-col gap-2">
                  <Frame
                    src={im.src}
                    alt={im.caption}
                    class="sheet-img w-full"
                    style="--frame-from:1.04;--frame-dur:1.1s"
                    sizes={`${frames[i].w * 2}px`}
                  />
                  <p class="t-meta">{im.label}</p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>

  <CommissionsBand page="work" />
  <ContactBand />
</Base>

<script>
  function initFilters() {
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]")
    const blocks = document.querySelectorAll<HTMLElement>("[data-series]")
    buttons.forEach((b) =>
      b.addEventListener("click", () => {
        const value = b.dataset.filter!
        buttons.forEach((x) => x.removeAttribute("data-active"))
        b.setAttribute("data-active", "")
        blocks.forEach((block) => {
          block.hidden = !(value === "all" || block.dataset.series === value)
        })
        if (value !== "all") {
          const target = document.querySelector<HTMLElement>(`[data-series="${value}"]`)
          target?.scrollIntoView({ behavior: "smooth", block: "start" })
        }
      })
    )
  }
  initFilters()
  document.addEventListener("astro:page-load", initFilters)
</script>

<style>
  .sheet-frame { width: var(--wt); }
  .sheet-frame :global(.sheet-img) { aspect-ratio: var(--ar); }
  @media (min-width: 1200px) { .sheet-frame { width: var(--w); } }
  @media (max-width: 809.98px) {
    .sheet { display: grid; grid-template-columns: 1fr 1fr; gap: 20px 12px; }
    .sheet-frame { width: auto; }
    .sheet-frame :global(.sheet-img) { aspect-ratio: var(--arp); }
  }
  .chip:hover { border-color: var(--color-blue); }
  .chip[data-active] { border-color: var(--color-blue); color: var(--color-blue); }
  .chip[data-active]:hover { background: rgba(99, 102, 241, 0.08); }
</style>
